# NeuroOS-Lite Environment Configuration Template
# Copy to .env for local overrides (never commit .env)

# System & Execution Environment
NEUROOS_ENV=development
NEUROOS_LOG_LEVEL=INFO

# Kernel & sched_ext Settings
NEUROOS_SCHED_EXT_ENABLED=0
NEUROOS_FALLBACK_THRESHOLD_TASKS=1024
NEUROOS_GUARDRAIL_SIGMA_THRESHOLD=3.0

# Telemetry & Ring Buffer Configuration
NEUROOS_RING_BUFFER_ENTRIES=65536
NEUROOS_TELEMETRY_UPDATE_HZ=2.0

# GPU & Training Worker Configuration
CUDA_VISIBLE_DEVICES=0
NEUROOS_TORCH_DEVICE=cuda
NEUROOS_BATCH_SIZE=256
NEUROOS_LEARNING_RATE=0.0003

# Benchmark & Trace Paths (Local filesystem only)
GOOGLE_BORG_TRACE_PATH=
SPEC_CPU2017_TRACE_PATH=
MIBENCH_TRACE_PATH=
